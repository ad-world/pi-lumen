{
  "name": "pi-lumen",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension for Lumen diff review.",
  "type": "module",
  "keywords": ["pi-package", "pi", "lumen", "code-review", "diff"],
  "author": "ad-world",
